# Guardas adicionales: el runtime debe estar fuera de este módulo.
.local/
appdata/
data/
downloads/
cache/
secrets/
backups/
exports/

# Generated subtitle content and download archives are not repository sources.
# Keep reports, manifests and other run artifacts under the ignored exports/.
*.srt
*.vtt
*.ass
*.ssa
*.sub
*.idx
*.sup
*.zip

# Estado específico del cliente; las DB/SQLite se excluyen desde la raíz.
BT_backup/
*.torrent
*.fastresume

# Copias de configuración nativa y passdb: pueden contener claves o hashes.
# Publicar sólo las plantillas *.example, nunca exports del runtime.
config.xml
config.yaml
smb.conf
*.tdb
*.tdb-*
*.ldb
*.ldb-*
