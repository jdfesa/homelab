{
  "schema_version": 1,
  "format": "declarative-policy-not-direct-api-payload",
  "profile": {
    "name": "HD - 720p/1080p",
    "upgrade_allowed": false,
    "quality_groups": [
      {
        "name": "720p + 1080p (equal)",
        "qualities": [
          "HDTV-720p",
          "WEBDL-720p",
          "WEBRip-720p",
          "Bluray-720p",
          "HDTV-1080p",
          "WEBDL-1080p",
          "WEBRip-1080p",
          "Bluray-1080p",
          "Bluray-1080p Remux"
        ]
      }
    ],
    "allow_unlisted_qualities": false,
    "minimum_custom_format_score": 1,
    "custom_format_scores": {
      "Prefer original audio": 100,
      "English fallback": 10
    }
  },
  "custom_formats": [
    {
      "name": "Prefer original audio",
      "includeCustomFormatWhenRenaming": false,
      "specifications": [
        {
          "name": "Original language",
          "implementation": "LanguageSpecification",
          "negate": false,
          "required": false,
          "fields": {
            "value": -2,
            "exceptLanguage": false
          }
        }
      ]
    },
    {
      "name": "English fallback",
      "includeCustomFormatWhenRenaming": false,
      "specifications": [
        {
          "name": "English language",
          "implementation": "LanguageSpecification",
          "negate": false,
          "required": false,
          "fields": {
            "value": 1,
            "exceptLanguage": false
          }
        }
      ]
    }
  ],
  "naming": {
    "renameEpisodes": true,
    "replaceIllegalCharacters": true,
    "colonReplacementFormat": 4,
    "standardEpisodeFormat": "{Series Title} - S{season:00}E{episode:00} - {Episode Title} {Quality Full}",
    "dailyEpisodeFormat": "{Series Title} - {Air-Date} - {Episode Title} {Quality Full}",
    "animeEpisodeFormat": "{Series Title} - S{season:00}E{episode:00} - {Episode Title} {Quality Full}",
    "seriesFolderFormat": "{Series Title} ({Series Year})",
    "seasonFolderFormat": "Season {season:00}",
    "specialsFolderFormat": "Specials"
  },
  "quality_size_limits_changed": false,
  "screenshots": [
    "sonarr-initial-authentication.png",
    "sonarr-hd-profile-saved.jpg",
    "sonarr-episode-naming-saved.jpg",
    "sonarr-media-management-saved.jpg",
    "sonarr-download-client-saved.jpg",
    "sonarr-indexers-synced.jpg"
  ],
  "verified_sonarr_version": "4.0.20.3014"
}
